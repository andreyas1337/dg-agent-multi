# ── Credentials ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_api_key_here

# ── Mode ───────────────────────────────────────────────────────────────────
# Single-agent scenario mode: a folder name under scenarios/ (or a path to a
# .json). Leave unset (commented) to run a multi-agent scenario instead.
# See scenarios/README.md.
# SCENARIO_FILE=brightmoor-homecare

# Which multi-agent definition to run (path to its .py). Default: acme-support.
# AGENTS_SCENARIO=scenarios/financial-advisory/financial_advisory.py

# ── Text-to-speech ─────────────────────────────────────────────────────────
# Default voice; a per-agent voice (or a scenario's own voice) wins over this.
# Any Deepgram voice: classic aura-2-* or next-gen flux-* (e.g. flux-jack-en) —
# the model name alone selects the engine, no flag needed.
DEFAULT_VOICE=aura-2-asteria-en

# ── Live interim transcripts (separate STT socket) ─────────────────────────
ENABLE_INTERIM=false          # initial position of the UI toggle
INTERIM_PROVIDER=auto         # auto (follow agent's listen model) | nova | flux
